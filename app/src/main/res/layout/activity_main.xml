<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/logo"
        android:textSize="64sp"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/titre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accueil_titre"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/sousTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accueil_sous_titre"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/titre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/texteCouleur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/votre_couleur"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/sousTitre"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/couleur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/blancs"
        app:layout_constraintTop_toBottomOf="@id/texteCouleur"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/blancs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blancs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/noirs"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/noirs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/hasard"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hasard" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <TextView
        android:id="@+id/texteCreativite"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/creativite_titre"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/couleur"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/valeur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/creativite_initiale"
        app:layout_constraintTop_toTopOf="@id/texteCreativite"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.slider.Slider
        android:id="@+id/creativite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:valueFrom="0.0"
        android:valueTo="1.5"
        android:stepSize="0.1"
        android:value="0.6"
        app:layout_constraintTop_toBottomOf="@id/texteCreativite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/prudent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/prudent"
        app:layout_constraintTop_toBottomOf="@id/creativite"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/surprenant"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/surprenant"
        app:layout_constraintTop_toBottomOf="@id/creativite"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/nouvellePartie"
        style="@style/Philidor.Bouton.Plein"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/nouvelle_partie"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/prudent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/historique"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/historique_parties"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/nouvellePartie"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
